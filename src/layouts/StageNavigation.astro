---
import { getPrevNextLinks, withBase } from '@app/config/pages';
import styles from '@app/layouts/StageNavigation.module.css';

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const { previous, next } = getPrevNextLinks(currentPath);
---

{
  (previous || next) && (
    <nav class={styles.nav} aria-label="Навигация по этапам">
      <div class={styles.grid}>
        {previous ? (
          <a
            href={withBase(previous.href)}
            class={`${styles.link} ${styles.previous}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            <span class={`${styles.text} ${styles.textStart}`}>
              <span class={styles.group}>{previous.groupTitle}</span>
              <span class={styles.label}>{previous.label}</span>
            </span>
          </a>
        ) : (
          <div class={styles.placeholder}></div>
        )}

        {next ? (
          <a
            href={withBase(next.href)}
            class={`${styles.link} ${styles.next}`}
          >
            <span class={`${styles.text} ${styles.textEnd}`}>
              <span class={styles.group}>{next.groupTitle}</span>
              <span class={styles.label}>{next.label}</span>
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        ) : (
          <div class={styles.placeholder}></div>
        )}
      </div>
    </nav>
  )
}
