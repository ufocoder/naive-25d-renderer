---
import Drawer from '@app/layouts/Drawer.astro';
import { YandexMetrika } from 'astro-yandex-metrika';
import { getPageHeader, normalizePathname, withBase } from '@app/config/pages';
import StageNavigation from '@app/layouts/StageNavigation.astro';
import '@app/style.css';

const currentPath = normalizePathname(Astro.url.pathname);
const header = getPageHeader(currentPath);
const pageTitle = header
  ? `${header.label ?? header.title} | 2.5D Renderer`
  : '2.5D Renderer';
const serviceWorkerUrl = withBase('/sw.js');
const serviceWorkerScope = withBase('/');
const enableServiceWorker = import.meta.env.PROD;
const yandexMetrikaId = import.meta.env.PROD
  ? import.meta.env.YANDEX_METRIKA_ID ?? '110386071'
  : undefined;
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        if (localStorage.getItem('docs-sidebar-collapsed') === 'true') {
          document.documentElement.classList.add('docs-sidebar-collapsed');
        }
      } catch {}
    </script>
    {yandexMetrikaId && <YandexMetrika id={yandexMetrikaId} />}
  </head>
  <body>
    <div class="site-shell min-h-screen">
      <Drawer currentPath={currentPath} />
      <div class="docs-content-wrap px-4 py-6 lg:px-8 lg:py-12">
        <div class="docs-content-topbar">
          <a href={withBase('/about')} class="docs-topbar-brand">
            <span>2.5D Renderer</span>
            <small>почти как в DOOM 1993</small>
          </a>
          <div class="docs-topbar-actions">
            <button
              type="button"
              class="docs-sidebar-toggle"
              aria-label="Скрыть меню"
              aria-pressed="false"
              title="Скрыть меню"
              data-sidebar-toggle
              data-drawer-open
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="4" width="18" height="16"></rect>
                <path d="M9 4v16"></path>
                <path d="M14 10l3 2-3 2"></path>
              </svg>
              <span>Навигация</span>
            </button>

            <a
              href="https://github.com/ufocoder/25d-renderer"
              target="_blank"
              rel="noopener noreferrer"
              class="docs-icon-button"
              aria-label="GitHub"
            >
              <span>GitHub</span>
              <svg width="22" height="22" aria-hidden="true">
                <use href={withBase('/icons.svg#github-icon')}></use>
              </svg>
            </a>
          </div>
        </div>
        <div class="content-card flex min-h-[calc(100vh-3rem)] flex-col">
          <main class="flex-1">
            {
              header && (
                <div class="relative mb-8 pb-2">
                  <div>
                    {header.isLink ? (
                      <>
                        <p class="mb-2 text-sm font-medium text-[color:var(--muted)]">
                          {header.title}
                        </p>
                        <h1 class="text-3xl font-semibold text-[color:var(--ink)] lg:text-4xl">
                          {header.label}
                        </h1>
                      </>
                    ) : (
                      <h1 class="text-3xl font-semibold text-[color:var(--ink)] lg:text-4xl">
                        {header.title}
                      </h1>
                    )}
                  </div>
                </div>
              )
            }
            <slot />
          </main>
        </div>
        <StageNavigation currentPath={currentPath} />
      </div>
    </div>
    <script define:vars={{ enableServiceWorker, serviceWorkerScope, serviceWorkerUrl }}>
      if (enableServiceWorker && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(serviceWorkerUrl, {
            scope: serviceWorkerScope,
            updateViaCache: 'none',
          });
        });
      }
    </script>
    <script>
      const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
      const isDesktopSidebar = () => window.matchMedia('(min-width: 1024px)').matches;
      const syncSidebarToggle = () => {
        const isCollapsed = document.documentElement.classList.contains('docs-sidebar-collapsed');

        sidebarToggle?.setAttribute('aria-pressed', String(isCollapsed));
        sidebarToggle?.setAttribute(
          'aria-label',
          isCollapsed && isDesktopSidebar() ? 'Показать меню' : 'Скрыть меню',
        );
        sidebarToggle?.setAttribute(
          'title',
          isCollapsed && isDesktopSidebar() ? 'Показать меню' : 'Скрыть меню',
        );
      };

      sidebarToggle?.addEventListener('click', () => {
        if (!isDesktopSidebar()) return;

        const isCollapsed = document.documentElement.classList.toggle('docs-sidebar-collapsed');

        try {
          localStorage.setItem('docs-sidebar-collapsed', String(isCollapsed));
        } catch {}

        syncSidebarToggle();
      });

      syncSidebarToggle();
    </script>
  </body>
</html>
