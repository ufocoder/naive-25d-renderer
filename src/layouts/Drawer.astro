---
import {
  getMenuEntries,
  isMenuGroup,
  isPathActive,
  type MenuGroup,
  withBase,
} from '@app/config/pages';
import styles from '@app/layouts/Drawer.module.css';

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const menuEntries = getMenuEntries();
const rootEntries = menuEntries.filter((entry) => !isMenuGroup(entry));
const aboutEntry = rootEntries.find((entry) => entry.href === '/about');
const prefaceEntry = rootEntries.find((entry) => entry.href === '/preface');
const editorEntry = rootEntries.find((entry) => entry.href === '/editor');
const primaryRootEntries = rootEntries.filter(
  (entry) => entry.href !== '/about' && entry.href !== '/preface' && entry.href !== '/editor',
);
const stageGroups = menuEntries.filter(
  (entry): entry is MenuGroup => isMenuGroup(entry) && entry.title.startsWith('Stage '),
);
const isGroupActive = (entry: MenuGroup) =>
  entry.links.some((link) => isPathActive(currentPath, link.href));
const isPrefaceActive = prefaceEntry ? isPathActive(currentPath, prefaceEntry.href) : false;
const isContentActive = isPrefaceActive || stageGroups.some((entry) => isGroupActive(entry));
const navLinkClass = (active: boolean, ...extraClasses: string[]) =>
  [styles.navLink, active ? styles.navLinkActive : '', ...extraClasses]
    .filter(Boolean)
    .join(' ');
const drawerClasses = {
  drawerOpen: styles.drawerOpen,
  drawerClosed: styles.drawerClosed,
  drawerBackdropVisible: styles.drawerBackdropVisible,
  drawerPanelOpen: styles.drawerPanelOpen,
};
---

<aside class={styles.sidebar}>
  <a href={withBase('/')} class={styles.brand}>
    <span>
      <span>2.5D Renderer</span>
      <small>почти как в DOOM 1993</small>
    </span>
  </a>

  <nav class={styles.sidebarNav}>
    <div class={styles.navList}>
      {primaryRootEntries.map((entry) => (
        <a
          href={withBase(entry.href)}
          class={navLinkClass(isPathActive(currentPath, entry.href), styles.navLinkRoot)}
        >
          <span>{entry.label}</span>
        </a>
      ))}

      {stageGroups.length > 0 && (
        <section class={styles.navSection}>
          <div class={`${styles.navHeading} ${isContentActive ? styles.navHeadingActive : ''}`}>
            Основное содержание
          </div>

          <div data-drawer-group-content class={styles.navContent}>
            <div class={styles.stageMenu}>
              {prefaceEntry && (
                <section class={styles.stageSection}>
                  <a
                    href={withBase(prefaceEntry.href)}
                    class={navLinkClass(
                      isPathActive(currentPath, prefaceEntry.href),
                      styles.navLinkRoot,
                      styles.prefaceLink,
                    )}
                  >
                    {prefaceEntry.label}
                  </a>
                </section>
              )}

              {stageGroups.map((entry) => (
                <section class={styles.stageSection}>
                  <a
                    href={withBase(entry.links[0].href)}
                    data-drawer-group
                    data-expanded={isGroupActive(entry) ? 'true' : 'false'}
                    class={styles.groupLink}
                  >
                    <span class={styles.groupTitle}>{entry.title}</span>
                  </a>

                  {isGroupActive(entry) && (
                    <div
                      data-drawer-group-content
                      class={styles.groupContent}
                    >
                      <ul>
                        {entry.links.map((link) => (
                          <li>
                            <a
                              href={withBase(link.href)}
                              class={navLinkClass(isPathActive(currentPath, link.href))}
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </section>
              ))}
            </div>
          </div>
        </section>
      )}

      {(editorEntry || aboutEntry) && (
        <section class={styles.navSection}>
          <div class={styles.navHeading}>Дополнительно</div>

          <div class={styles.navContent}>
            {editorEntry && (
              <a
                href={withBase(editorEntry.href)}
                class={navLinkClass(
                  isPathActive(currentPath, editorEntry.href),
                  styles.navLinkRoot,
                  styles.navLinkIcon,
                )}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                </svg>
                <span>{editorEntry.label}</span>
              </a>
            )}

            {aboutEntry && (
              <a
                href={withBase(aboutEntry.href)}
                class={navLinkClass(
                  isPathActive(currentPath, aboutEntry.href),
                  styles.navLinkRoot,
                  styles.navLinkIcon,
                )}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 16v-4"></path>
                  <path d="M12 8h.01"></path>
                </svg>
                <span>{aboutEntry.label}</span>
              </a>
            )}
          </div>
        </section>
      )}
    </div>
  </nav>
</aside>

<div data-drawer class={`${styles.drawer} ${styles.drawerClosed}`}>
  <button
    type="button"
    aria-label="Закрыть меню"
    data-drawer-close
    class={styles.drawerBackdrop}
  ></button>

  <aside
    data-drawer-panel
    class={styles.drawerPanel}
  >
    <div class={styles.drawerHeader}>
      <span class={styles.drawerTitle}>2.5D Renderer</span>
      <button type="button" aria-label="Закрыть меню" data-drawer-close class={styles.iconButton}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <nav class={styles.drawerNav}>
      <div class={styles.navList}>
        {primaryRootEntries.map((entry) => (
          <a
            href={withBase(entry.href)}
            class={navLinkClass(isPathActive(currentPath, entry.href), styles.navLinkRoot)}
          >
            <span>{entry.label}</span>
          </a>
        ))}

        {stageGroups.length > 0 && (
          <section class={styles.navSection}>
            <div class={`${styles.navHeading} ${isContentActive ? styles.navHeadingActive : ''}`}>
              Основное содержание
            </div>

            <div data-drawer-group-content class={styles.navContent}>
              <div class={styles.stageMenu}>
                {prefaceEntry && (
                  <section class={styles.stageSection}>
                    <a
                      href={withBase(prefaceEntry.href)}
                      class={navLinkClass(
                        isPathActive(currentPath, prefaceEntry.href),
                        styles.navLinkRoot,
                        styles.prefaceLink,
                      )}
                    >
                      {prefaceEntry.label}
                    </a>
                  </section>
                )}

                {stageGroups.map((entry) => (
                  <section class={styles.stageSection}>
                    <a
                      href={withBase(entry.links[0].href)}
                      data-drawer-group
                      data-expanded={isGroupActive(entry) ? 'true' : 'false'}
                      class={styles.groupLink}
                    >
                      <span class={styles.groupTitle}>{entry.title}</span>
                    </a>

                    {isGroupActive(entry) && (
                      <div
                        data-drawer-group-content
                        class={styles.groupContent}
                      >
                        <ul>
                          {entry.links.map((link) => (
                            <li>
                              <a
                                href={withBase(link.href)}
                                class={navLinkClass(isPathActive(currentPath, link.href))}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </section>
        )}

        {(editorEntry || aboutEntry) && (
          <section class={styles.navSection}>
            <div class={styles.navHeading}>Дополнительно</div>

            <div class={styles.navContent}>
              {editorEntry && (
                <a
                  href={withBase(editorEntry.href)}
                  class={navLinkClass(
                    isPathActive(currentPath, editorEntry.href),
                    styles.navLinkRoot,
                    styles.navLinkIcon,
                  )}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                  </svg>
                  <span>{editorEntry.label}</span>
                </a>
              )}

              {aboutEntry && (
                <a
                  href={withBase(aboutEntry.href)}
                  class={navLinkClass(
                    isPathActive(currentPath, aboutEntry.href),
                    styles.navLinkRoot,
                    styles.navLinkIcon,
                  )}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 16v-4"></path>
                    <path d="M12 8h.01"></path>
                  </svg>
                  <span>{aboutEntry.label}</span>
                </a>
              )}
            </div>
          </section>
        )}
      </div>
    </nav>
  </aside>
</div>

<script define:vars={{ drawerClasses }}>
  const drawer = document.querySelector('[data-drawer]');
  const panel = document.querySelector('[data-drawer-panel]');
  const openButtons = document.querySelectorAll('[data-drawer-open]');
  const closeButtons = document.querySelectorAll('[data-drawer-close]');
  const isMobileDrawer = () => window.matchMedia('(max-width: 1023px)').matches;
  const setDrawerOpen = (isOpen: boolean) => {
    if (!drawer || !panel) return;

    drawer.classList.toggle(drawerClasses.drawerOpen, isOpen);
    drawer.classList.toggle(drawerClasses.drawerClosed, !isOpen);
    drawer
      .querySelector('[data-drawer-close]')
      ?.classList.toggle(drawerClasses.drawerBackdropVisible, isOpen);
    panel.classList.toggle(drawerClasses.drawerPanelOpen, isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  };

  openButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (isMobileDrawer()) {
        setDrawerOpen(true);
      }
    });
  });
  closeButtons.forEach((button) => {
    button.addEventListener('click', () => setDrawerOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setDrawerOpen(false);
    }
  });

</script>
