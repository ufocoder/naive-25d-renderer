---
import {
  getMenuEntries,
  isMenuGroup,
  isPathActive,
  linkClass,
  type MenuGroup,
  withBase,
} from '@app/config/pages';

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const menuEntries = getMenuEntries();
const rootEntries = menuEntries.filter((entry) => !isMenuGroup(entry));
const aboutEntry = rootEntries.find((entry) => entry.href === '/about');
const prefaceEntry = rootEntries.find((entry) => entry.href === '/preface');
const editorEntry = rootEntries.find((entry) => entry.href === '/editor');
const primaryRootEntries = rootEntries.filter(
  (entry) => entry.href !== '/about' && entry.href !== '/preface' && entry.href !== '/editor',
);
const stageGroups = menuEntries.filter(
  (entry): entry is MenuGroup => isMenuGroup(entry) && entry.title.startsWith('Stage '),
);
const isGroupActive = (entry: MenuGroup) =>
  entry.links.some((link) => isPathActive(currentPath, link.href));
const isPrefaceActive = prefaceEntry ? isPathActive(currentPath, prefaceEntry.href) : false;
const isContentActive = isPrefaceActive || stageGroups.some((entry) => isGroupActive(entry));
---

<aside class="docs-sidebar hidden min-w-0 flex-col lg:flex">
  <a href={withBase('/')} class="docs-site-brand">
    <span>
      <span>2.5D Renderer</span>
      <small>почти как в DOOM 1993</small>
    </span>
  </a>

  <nav class="docs-sidebar-nav flex-1 overflow-y-auto px-3">
    <div class="flex flex-col">
      {primaryRootEntries.map((entry) => (
        <a
          href={withBase(entry.href)}
          class={`${linkClass(isPathActive(currentPath, entry.href))} docs-nav-link-root`}
        >
          <span>{entry.label}</span>
        </a>
      ))}

      {stageGroups.length > 0 && (
        <section class="docs-nav-section flex min-w-0 flex-col">
          <div class={`docs-nav-heading ${isContentActive ? 'docs-nav-heading-active' : ''}`}>
            Основное содержание
          </div>

          <div data-drawer-group-content class="overflow-hidden opacity-100">
            <div class="docs-stage-menu">
              {prefaceEntry && (
                <section class="flex min-w-0 flex-col gap-1">
                  <a
                    href={withBase(prefaceEntry.href)}
                    class={`${linkClass(isPathActive(currentPath, prefaceEntry.href))} docs-nav-link-root docs-preface-link`}
                  >
                    {prefaceEntry.label}
                  </a>
                </section>
              )}

              {stageGroups.map((entry) => (
                <section class="flex min-w-0 flex-col gap-1">
                  <a
                    href={withBase(entry.links[0].href)}
                    data-drawer-group
                    data-expanded={isGroupActive(entry) ? 'true' : 'false'}
                    class="docs-group"
                  >
                    <span class="flex-1 truncate text-left">{entry.title}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0 rotate-180 transition-transform"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </a>

                  {isGroupActive(entry) && (
                    <div
                      data-drawer-group-content
                      class="overflow-hidden opacity-100"
                    >
                      <ul class="m-0 list-none space-y-1 pl-0">
                        {entry.links.map((link) => (
                          <li>
                            <a
                              href={withBase(link.href)}
                              class={linkClass(isPathActive(currentPath, link.href))}
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </section>
              ))}
            </div>
          </div>
        </section>
      )}

      {(editorEntry || aboutEntry) && (
        <section class="docs-nav-section flex min-w-0 flex-col">
          <div class="docs-nav-heading">Дополнительно</div>

          <div class="docs-nav-section-items">
            {editorEntry && (
              <a
                href={withBase(editorEntry.href)}
                class={`${linkClass(isPathActive(currentPath, editorEntry.href))} docs-nav-link-root docs-nav-link-with-icon`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                </svg>
                <span>{editorEntry.label}</span>
              </a>
            )}

            {aboutEntry && (
              <a
                href={withBase(aboutEntry.href)}
                class={`${linkClass(isPathActive(currentPath, aboutEntry.href))} docs-nav-link-root docs-nav-link-with-icon`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 16v-4"></path>
                  <path d="M12 8h.01"></path>
                </svg>
                <span>{aboutEntry.label}</span>
              </a>
            )}
          </div>
        </section>
      )}
    </div>
  </nav>
</aside>

<div data-drawer class="pointer-events-none fixed inset-0 z-50 transition-all duration-300 lg:hidden">
  <button
    type="button"
    aria-label="Закрыть меню"
    data-drawer-close
    class="absolute inset-0 bg-black opacity-0 transition-opacity duration-300"
  ></button>

  <aside
    data-drawer-panel
    class="docs-drawer-panel absolute bottom-0 left-0 top-0 w-80 max-w-[85vw] -translate-x-full transform transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between px-4 py-4">
      <span class="text-lg font-normal text-[color:var(--ink)]">2.5D Renderer</span>
      <button type="button" aria-label="Закрыть меню" data-drawer-close class="docs-icon-button">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-5 overflow-y-auto p-4" style="max-height: calc(100vh - 5rem);">
      <div class="flex flex-col">
        {primaryRootEntries.map((entry) => (
          <a
            href={withBase(entry.href)}
            class={`${linkClass(isPathActive(currentPath, entry.href))} docs-nav-link-root`}
          >
            <span>{entry.label}</span>
          </a>
        ))}

        {stageGroups.length > 0 && (
          <section class="docs-nav-section flex min-w-0 flex-col">
            <div class={`docs-nav-heading ${isContentActive ? 'docs-nav-heading-active' : ''}`}>
              Основное содержание
            </div>

            <div data-drawer-group-content class="overflow-hidden opacity-100">
              <div class="docs-stage-menu">
                {prefaceEntry && (
                  <section class="flex min-w-0 flex-col gap-1">
                    <a
                      href={withBase(prefaceEntry.href)}
                      class={`${linkClass(isPathActive(currentPath, prefaceEntry.href))} docs-nav-link-root docs-preface-link`}
                    >
                      {prefaceEntry.label}
                    </a>
                  </section>
                )}

                {stageGroups.map((entry) => (
                  <section class="flex min-w-0 flex-col gap-1">
                    <a
                      href={withBase(entry.links[0].href)}
                      data-drawer-group
                      data-expanded={isGroupActive(entry) ? 'true' : 'false'}
                      class="docs-group"
                    >
                      <span class="flex-1 text-left">{entry.title}</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="rotate-180 transition-transform"
                        aria-hidden="true"
                      >
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </a>

                    {isGroupActive(entry) && (
                      <div
                        data-drawer-group-content
                        class="overflow-hidden opacity-100"
                      >
                        <ul class="m-0 list-none space-y-1 pl-0">
                          {entry.links.map((link) => (
                            <li>
                              <a
                                href={withBase(link.href)}
                                class={linkClass(isPathActive(currentPath, link.href))}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </section>
        )}

        {(editorEntry || aboutEntry) && (
          <section class="docs-nav-section flex min-w-0 flex-col">
            <div class="docs-nav-heading">Дополнительно</div>

            <div class="docs-nav-section-items">
              {editorEntry && (
                <a
                  href={withBase(editorEntry.href)}
                  class={`${linkClass(isPathActive(currentPath, editorEntry.href))} docs-nav-link-root docs-nav-link-with-icon`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                  </svg>
                  <span>{editorEntry.label}</span>
                </a>
              )}

              {aboutEntry && (
                <a
                  href={withBase(aboutEntry.href)}
                  class={`${linkClass(isPathActive(currentPath, aboutEntry.href))} docs-nav-link-root docs-nav-link-with-icon`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 16v-4"></path>
                    <path d="M12 8h.01"></path>
                  </svg>
                  <span>{aboutEntry.label}</span>
                </a>
              )}
            </div>
          </section>
        )}
      </div>
    </nav>
  </aside>
</div>

<script>
  const drawer = document.querySelector('[data-drawer]');
  const panel = document.querySelector('[data-drawer-panel]');
  const openButtons = document.querySelectorAll('[data-drawer-open]');
  const closeButtons = document.querySelectorAll('[data-drawer-close]');
  const isMobileDrawer = () => window.matchMedia('(max-width: 1023px)').matches;
  const setDrawerOpen = (isOpen: boolean) => {
    if (!drawer || !panel) return;

    drawer.classList.toggle('pointer-events-auto', isOpen);
    drawer.classList.toggle('pointer-events-none', !isOpen);
    drawer.querySelector('[data-drawer-close]')?.classList.toggle('opacity-50', isOpen);
    drawer.querySelector('[data-drawer-close]')?.classList.toggle('opacity-0', !isOpen);
    panel.classList.toggle('translate-x-0', isOpen);
    panel.classList.toggle('-translate-x-full', !isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  };

  const syncGroup = (button: Element) => {
    const isExpanded = button.getAttribute('data-expanded') === 'true';
    const content = button.nextElementSibling;
    const icon = button.querySelector('svg');

    content?.classList.toggle('opacity-100', isExpanded);
    content?.classList.toggle('opacity-0', !isExpanded);
    content?.classList.toggle('max-h-0', !isExpanded);
    icon?.classList.toggle('rotate-180', isExpanded);
  };

  openButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (isMobileDrawer()) {
        setDrawerOpen(true);
      }
    });
  });
  closeButtons.forEach((button) => {
    button.addEventListener('click', () => setDrawerOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setDrawerOpen(false);
    }
  });

  document.querySelectorAll('[data-drawer-group]').forEach((button) => {
    syncGroup(button);
  });
</script>
