---
import PageLayout from '@app/layouts/PageLayout.astro';
import Stage from '@app/pages/stage/_islands/Stage3d';
import type { PageMetadata } from '@app/config/pages';
import { codeToHtml } from 'shiki';

export const metadata: PageMetadata = {
  title: 'Отрисовка внутреннего сектора',
  groupTitle: 'Stage 3: Binary Space Partition',
};

const code1 = ` function render25d(
    ctx: CanvasRenderingContext2D,
    settings: Settings,
  ) {
    const camera = settings.camera;
    const allSegments = settings.level.linedefs;
    const bspTree = buildBSPTree(allSegments);
    const solidWallRanges = createSolidWallRanges(camera);

    traverseBSPTree(bspTree, camera, (bspNode: BSPLeaf) => {
      for (const seg of bspNode.segs) {
        const sector = seg.frontSector!;

        const projection = projectSeg(camera, sector, seg);

        if (!projection) {
          continue;
        }

        drawSolidWall(ctx, camera, seg, projection, solidWallRanges);
      }
    });
  }`;


const code1Html = await codeToHtml(code1, { lang: 'ts', theme: 'github-light' });
---

<PageLayout>
  <section class="flex flex-col gap-4">
    <p class="py-2 text">
      Вернемся к проблеме с отрисовкой внутреннего сектора. Теперь вместо сортировки стен по расстоянию от камеры мы используем BSP-дерево и получаем гарантированный порядок отрисовки стен от ближних стен к дальним.
    </p>
    <Stage part={0} client:load />
    <h2 class="text-2xl">
      Немного кода
    </h2>
    <p class="py-2 text">
      Может показаться, что на каждом кадре строится дерево, на самом деле используется кэш. <code class="rounded bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-800">Callback</code> функция для <code class="rounчded bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-800">traverseBSPTree</code> обрабатывает листы BSP-дерева, те те самые выпуклые многоуольники. Сегменты из листа BSP-дерева проецируются и передаются функции отрисовки непрозрачной стены:
    </p>
    <div set:html={code1Html} />
  </section>
</PageLayout>
