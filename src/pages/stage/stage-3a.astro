---
import content from '@app/styles/content.module.css';
import PageLayout from '@app/layouts/PageLayout.astro';
import Stage from '@app/pages/stage/_islands/Stage3a';
import type { PageMetadata } from '@app/config/pages';
import { PROJECT_REPO_URL } from '@app/config/repo';
import { withBase } from '@app/config/pages';

export const metadata: PageMetadata = {
  title: 'Отрисовка внутреннего сектора',
  groupTitle: 'Stage 3: Binary Space Partition',
};
---

<PageLayout>
  <section class={content.contentSection}>
    <p class={content.paragraph}>
      Получившийся портальный рендер из <a class={content.articleLink} href={withBase('/stage/stage-2a')}>Stage 2</a> хорошо работает, когда сектора соединены последовательно. Но уровень может содержать сектор внутри другого сектора — например, колонну, платформу или яму посреди комнаты. С этим испытанием текущий отрисовщик не справляется.
    </p>
    <p class={content.paragraph}>
      Например, сначала представим границу внутреннего сектора через портальные сегменты:
    </p>
    <Stage part={0} client:load />
    <p class={content.paragraph}>
      Теперь сделаем те же границы между секторами, но в виде обычных непрозрачных стен:
    </p>
    <Stage part={1} client:load />
    <p class={content.paragraph}>
      Текущий отрисовщик <span class={content.boldText}>не умеет проецировать внутренние сектора</span>.
    </p>
    <p class={content.paragraph}>
      <a href={`${PROJECT_REPO_URL}/stages/Stage3a/render25d.ts`} target="_blank" rel="noopener noreferrer" class={content.referenceLink} >Реализация шага на github</a>
    </p>
  </section>
</PageLayout>
