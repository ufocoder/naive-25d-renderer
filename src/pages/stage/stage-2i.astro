---
import content from '@app/styles/content.module.css';
import PageLayout from '@app/layouts/PageLayout.astro';
import Stage from '@app/pages/stage/_islands/Stage2i';
import type { PageMetadata } from '@app/config/pages';
import { PROJECT_REPO_URL } from '@app/config/repo';

export const metadata: PageMetadata = {
  title: 'Порталы 2D: трапеция',
  groupTitle: 'Stage 2: Отрисовка секторов',
};
---

<PageLayout>
  <section class={content.contentSection}>
    <p class={content.paragraph}>
      Если мы продвинемся немного вперед по уровню, то заметим, что портал это не прямоугольная область — а трапеция. Ее верхняя и нижняя стороны повторяют перспективный наклон стены. Теперь при рекурсивном обходе стены, пол и потолок соседнего сектора обрезаются по границам этой трапеции. 
    </p>
    <p class={content.paragraph}>
      Пурпурный контур в демонстрации показывает окно портала, через которое продолжается отрисовка уровня.
    </p>
    <Stage client:load />
    <p class={content.paragraph}>
      <a
        href={`${PROJECT_REPO_URL}/stages/Stage2i/render25d.ts`}
        target="_blank"
        rel="noopener noreferrer"
        class={content.referenceLink}
      >
        Реализация шага на github
      </a>
    </p>
  </section>
</PageLayout>
