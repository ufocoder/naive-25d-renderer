---
import content from '@app/styles/content.module.css';
import { codeToHtml } from 'shiki';
import PageLayout from '@app/layouts/PageLayout.astro';
import Stage from '@app/pages/stage/_islands/Stage2k';
import type { PageMetadata } from '@app/config/pages';
import { PROJECT_REPO_URL } from '@app/config/repo';

const codeCamera = `  interface Camera {
    // ..
    z: number;
  }`;


const codeCameraHtml = await codeToHtml(codeCamera, { lang: 'ts', theme: 'github-light' });

export const metadata: PageMetadata = {
  title: 'Высота камеры',
  groupTitle: 'Stage 2: Отрисовка секторов',
};
---

<PageLayout>
  <section class={content.contentSection}>
    <p class={content.paragraph}>
      Когда мы добавляли в отрисовщик поддержку уровня пола и уровня высоты для сектора, то предполагали фиксированное положение наблюдателя. Добавим координату <code class={content.inlineCode}>camera.z</code> и будем вычислять высоту пола и потолка относительно нее.
    </p>
    <div set:html={codeCameraHtml} />
    <p class={content.paragraph}>
      Кнопки под 2.5D-отрисовщиком запускают и останавливают циклическое изменение высоты камеры от пола до потолка. Вид сверху при этом не меняется, поскольку координата Z влияет только на вертикальную проекцию:
    </p>
    <Stage client:load />
    <p class={content.paragraph}>
      <a
        href={`${PROJECT_REPO_URL}/pages/stage/_islands/Stage2k.tsx`}
        target="_blank"
        rel="noopener noreferrer"
        class={content.referenceLink}
      >
        Реализация шага на github
      </a>
    </p>
  </section>
</PageLayout>
