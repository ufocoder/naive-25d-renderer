---
import editorStyles from '@app/styles/editor.module.css';
import gateStyles from '@app/styles/gate.module.css';
import { withBase } from '@app/config/pages';

type Props = {
  message?: string;
};

const {
  message = 'Данная страница еще в разработке, уверены, что хотите ознакомиться?',
} = Astro.props;
---

<div
  class={gateStyles.gateOverlay}
  data-development-gate
  role="dialog"
  aria-modal="true"
  aria-labelledby="development-gate-title"
>
  <div class={gateStyles.gatePanel}>
    <p id="development-gate-title" class={editorStyles.editorJsonTitle}>
      {message}
    </p>
    <div class={gateStyles.gateActions}>
      <a
        class={gateStyles.gateSecondaryButton}
        href={withBase('/about')}
      >
        вернуться
      </a>
      <button
        class={gateStyles.gatePrimaryButton}
        type="button"
        data-development-gate-confirm
      >
        уверен
      </button>
    </div>
  </div>
</div>

<script>
  const gates = document.querySelectorAll('[data-development-gate]');

  const syncScrollLock = () => {
    document.body.style.overflow = document.querySelector('[data-development-gate]')
      ? 'hidden'
      : '';
  };

  gates.forEach((gate) => {
    const button = gate.querySelector('[data-development-gate-confirm]');
    button?.addEventListener('click', () => {
      gate.remove();
      syncScrollLock();
    });
  });

  syncScrollLock();
</script>
